from sklearn.preprocessing import StandardScaler
X=df[['annual_income',
      'spending_score']]
scaler=StandardScaler()
X_scaled=scaler.fit_transform(X)
from sklearn.cluster import KMeans
inertias=[]
for k in range(1,11):
    model=KMeans(
        n_clusters=k,
        random_state=42,
        n_init=10
    )
    model.fit(X_scaled)
    inertias.append(model.inertia_)
plt.plot(range(1,11),inertias,marker='o')
plt.xlabel("Number of Clusters")
plt.ylabel("Inertia")
plt.title("Elbow Method")
plt.show()

k=5
kmeans=KMeans(
    n_clusters=k,
    random_state=42,
    n_init=10
)
kmeans_labels=kmeans.fit_predict(X_scaled)
plt.scatter(
    X_scaled[:,0],
    X_scaled[:,1],
    c=kmeans_labels,
    cmap='viridis'
)
plt.scatter(
    kmeans.cluster_centers_[:,0],
    kmeans.cluster_centers_[:,1],
    c='red',
    marker='X',
    s=200,
    label='Centroids'
)
plt.xlabel("Standardized Annual Income")
plt.ylabel("Standardized Spending Score")
plt.title("K-Means Clustering")
plt.legend()
plt.show()

from sklearn.cluster import AgglomerativeClustering
hierarchichal=AgglomerativeClustering(
    n_clusters=k,
    linkage='ward'
)
hierarchichal_labels=(
    hierarchichal.fit_predict(X_scaled)
)
plt.scatter(
    X_scaled[:,0],
    X_scaled[:,1],
    c=hierarchichal_labels,
    cmap='viridis'
)
plt.xlabel("Standardized Annual Income")
plt.ylabel("Standardized Spending Score")
plt.title("Agglomerative Hierarchichal Clustering")
plt.show()

from scipy.cluster.hierarchy import(
linkage,dendrogram
)
linked=linkage(X_scaled,method='ward')
plt.figure(figsize=(12,5))
dendrogram(linked)
plt.title("Hierarchichal Clustering Dendrogram")
plt.xlabel("Customers")
plt.ylabel("Linkage Distances")
plt.show()

from sklearn.metrics import silhouette_score
import numpy as np
kmeans_sil=silhouette_score(
    X_scaled,kmeans_labels
)
hierarchichal_sil=silhouette_score(
    X_scaled,hierarchichal_labels
)
def calculate_inertia(X,labels):
    total=0
    for cluster in np.unique(labels):
        points=X[labels==cluster]
        centroid=points.mean(axis=0)
        total+=np.sum(
        (points-centroid)**2)
    return total
results=pd.DataFrame({
    "Algorithm":["K-Means","Agglomerative"],
    "Inertia":[
        kmeans.inertia_,
        calculate_inertia(
            X_scaled,hierarchichal_labels 
        )
    ],
    "Silhouette Score":[
        kmeans_sil,hierarchichal_sil
    ]
})
print(results)
